<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Inherits: BOM with ~300 compatible versions, plugin configurations
        (compiler, surefire, resources), UTF-8 encoding, and spring-boot-maven-plugin
        pre-configured to produce an executable fat JAR.
        <relativePath/> tells Maven to always resolve from the remote repository,
        never from a local parent pom.xml on disk.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath />
    </parent>

    <groupId>dev.emit</groupId>
    <artifactId>emit</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>emit</name>
    <description>Multi-tenant Document and Invoice Processing Engine</description>

    <properties>
        <java.version>21</java.version>
        <!--
            JJWT is not in the Spring Boot BOM - version declared here
            for centralized management. Update in one place if needed.
        -->
        <jjwt.version>0.12.5</jjwt.version>
    </properties>

    <dependencies>

        <!--
            Lombok generates getters, setters, constructors, and more at compile time
            via annotation processor. optional=true means it is excluded from the final
            .jar - it is a build-time tool only.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Reads @ConfigurationProperties classes at compile time and generates
            META-INF/spring-configuration-metadata.json. IDEs merge this with
            additional-spring-configuration-metadata.json to provide validation,
            documentation, and autocompletion for all custom properties.
            optional=true excludes it from the runtime classpath - build-time tool only.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================================================
             WEB & VALIDATION
             spring-boot-starter-web includes: Spring MVC, embedded Tomcat,
             Jackson (JSON), spring-web, spring-webmvc.
             starter-validation includes: Hibernate Validator (the Jakarta Bean
             Validation implementation - annotations @NotNull, @Valid, etc.)
             ================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ==================================================
             DATA PERSISTENCE
             starter-data-jpa includes: Hibernate ORM, Spring Data JPA,
             HikariCP (default connection pool since Spring Boot 2+),
             spring-tx (transaction management).
             ================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            SCOPE RUNTIME: application code compiles against javax.sql.Connection
            (JDK interface). The PostgreSQL driver is an implementation loaded at
            runtime by DriverManager via ServiceLoader.
            Declaring it as compile would work but misrepresents the intent:
            the domain layer does not depend on PostgreSQL.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Liquibase manages the database schema via versioned changesets.
            Never use ddl-auto=create/update in production - use Liquibase.
            Spring Boot auto-configures Liquibase when this jar is on the classpath
            and spring.liquibase.change-log is set.
        -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- ==================================================
             SECURITY
             starter-security includes: Spring Security core, HTTP filters,
             BCryptPasswordEncoder, SecurityContextHolder.
             ================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            JJWT follows the SPI (Service Provider Interface) pattern.
            jjwt-api: public interfaces - application code only imports from here.
            jjwt-impl: implementation - RUNTIME because application code does not
                       import its classes directly. ServiceLoader discovers it.
            jjwt-jackson: JSON serialization for claims - RUNTIME for the same reason.
            Declaring impl as compile would allow accidentally importing internals.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================================================
             ASYNC & RETRY
             spring-retry: @Retryable, @Recover, @Backoff annotations.
             spring-boot-starter-aop: Spring AOP via AspectJ - required for
             @Retryable to work (it is implemented as an aspect).
             Without AOP, @Retryable silently does nothing.
             ================================================== -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ==================================================
             OBSERVABILITY
             Actuator exposes endpoints: /actuator/health, /actuator/metrics,
             /actuator/hikaricp (live pool stats).
             Essential for production monitoring.
             ================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================================================
             PDF GENERATION
             Thymeleaf template engine + Flying Saucer HTML-to-PDF renderer.
             ================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xhtmlrenderer</groupId>
            <artifactId>flying-saucer-pdf-openpdf</artifactId>
            <version>9.1.22</version>
        </dependency>

        <!-- ==================================================
             API DOCS
             springdoc-openapi generates the OpenAPI 3 specification automatically
             from Spring MVC annotations and serves Swagger UI at
             /swagger-ui/index.html - no extra configuration needed.
             ================================================== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>

        <!-- ==================================================
             CACHE / RATE LIMITING
             spring-data-redis + Lettuce (the default client) provide the
             RedisTemplate and StringRedisTemplate used by RateLimiterService.
             Rate limiting uses a Lua script executed atomically on Redis so
             the sliding-window check-and-increment is race-free across every
             application instance sharing the same Redis cluster.
             ================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ==================================================
             MESSAGING
             spring-kafka includes: KafkaTemplate, @KafkaListener,
             @RetryableTopic, ConcurrentKafkaListenerContainerFactory.
             ================================================== -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ==================================================
             TEST
             spring-boot-starter-test includes: JUnit 5, Mockito, AssertJ,
             Hamcrest, MockMvc, @SpringBootTest.
             spring-security-test: @WithMockUser, SecurityMockMvcRequestPostProcessors.
             spring-boot-testcontainers: automatic Testcontainers + Spring Boot 3 integration.
             testcontainers/junit-jupiter: @Testcontainers, @Container annotations.
             testcontainers/postgresql: Docker-managed PostgreSQL image for tests.
             ================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                spring-boot-maven-plugin packages the project as a fat JAR:
                a single JAR with all dependencies embedded, executable via
                `java -jar emit-0.0.1-SNAPSHOT.jar` with no server installation.
                Uses a custom classloader (LaunchedURLClassLoader) to load classes
                from nested JARs - not a flat uber-jar, but a BOOT-INF/lib/
                structure inside the JAR.
            -->
            <!--
                Lombok and the configuration processor are build-time tools only:
                they generate code and metadata at compile time and have no runtime role.
                Without explicit exclusion, the Spring Boot repackaging goal includes ALL
                compile-scope dependencies - even optional ones - in the fat JAR.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
