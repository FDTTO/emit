{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["src/main/resources/static/**/*.{js,css}", "docs/design/**/*.{js,css}", "demo/**/*.js", "!!tools"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "useArrowFunction": "off",
        "useOptionalChain": "off",
        "noImportantStyles": "off"
      },
      "style": {
        "useTemplate": "off",
        "noDescendingSpecificity": "off",
        "useConst": "error"
      },
      "suspicious": {
        "noVar": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["docs/design/fidelity/shared.js"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off" } } }
    }
  ]
}
