<?xml version="1.0" encoding="UTF-8"?>
<!--
    tenantSchema, requestId and adminUser come from the MDC (TenantFilter,
    RequestIdFilter, JwtAuthenticationFilter); admin= prints only when one is set.
    Each pattern stays on one line: a line break inside the element is printed,
    splitting every entry in two for any collector that reads line by line.
-->
<configuration>

    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%cyan(%X{tenantSchema:-system})] [%magenta(%X{requestId:-no-req})]%replace( admin=%X{adminUser}){' admin=$', ''} %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <springProfile name="!dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{ISO8601} %-5level [%X{tenantSchema:-system}] [%X{requestId:-no-req}]%replace( admin=%X{adminUser}){' admin=$', ''} %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>
