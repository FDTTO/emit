<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Applied changeSets are never edited: Liquibase refuses to start on a changed checksum. -->
    <changeSet id="001" author="emit-dev">
        <createTable tableName="tenants" schemaName="public">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" />
            </column>
            <!-- 63: PostgreSQL's identifier limit; longer names are truncated. -->
            <column name="schema_name" type="VARCHAR(63)">
                <constraints nullable="false" unique="true" />
            </column>
            <!-- Only the hash: a leaked table exposes no usable key. -->
            <column name="api_key_hash" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex indexName="idx_tenants_schema_name" tableName="tenants" schemaName="public">
            <column name="schema_name" />
        </createIndex>

        <!-- Every authenticated tenant request looks its key up by hash. -->
        <createIndex indexName="idx_tenants_api_key_hash" tableName="tenants" schemaName="public">
            <column name="api_key_hash" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
