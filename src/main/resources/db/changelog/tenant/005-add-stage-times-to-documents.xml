<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-add-stage-times-to-documents" author="emit">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="documents" columnName="queued_at"/></not>
        </preConditions>
        <addColumn tableName="documents">
            <column name="queued_at" type="TIMESTAMPTZ" />
            <column name="started_at" type="TIMESTAMPTZ" />
            <column name="finished_at" type="TIMESTAMPTZ" />
        </addColumn>
    </changeSet>

</databaseChangeLog>
